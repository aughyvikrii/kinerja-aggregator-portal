<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TalentOps Aggregator Platform</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-zinc-50 min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-5xl">
        <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-zinc-900 rounded-2xl mb-6">
                <i data-lucide="hexagon" class="w-8 h-8 text-white"></i>
            </div>
            <h1 class="text-3xl font-bold text-zinc-900 mb-2">TalentOps Aggregator Platform</h1>
            <p class="text-zinc-500">Select an application to continue</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="apps/public-portal/index.html" class="group bg-white rounded-2xl border border-zinc-200 p-8 hover:border-emerald-600 hover:shadow-lg transition-all">
                <div class="w-12 h-12 bg-emerald-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i data-lucide="globe" class="w-6 h-6 text-white"></i>
                </div>
                <h2 class="text-xl font-semibold text-zinc-900 mb-2">Public Portal</h2>
                <p class="text-zinc-500 text-sm mb-4">Order services without registration - open to all</p>
                <div class="flex items-center text-sm font-medium text-emerald-600">
                    Order Now
                    <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
                </div>
            </a>

            <a href="apps/aggregator-platform/login.html" class="group bg-white rounded-2xl border border-zinc-200 p-8 hover:border-zinc-900 hover:shadow-lg transition-all">
                <div class="w-12 h-12 bg-zinc-900 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i data-lucide="layout-grid" class="w-6 h-6 text-white"></i>
                </div>
                <h2 class="text-xl font-semibold text-zinc-900 mb-2">Aggregator Platform</h2>
                <p class="text-zinc-500 text-sm mb-4">For Partners, Admins, and Company Viewers</p>
                <div class="flex items-center text-sm font-medium text-zinc-900">
                    Enter Platform
                    <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
                </div>
            </a>

            <a href="apps/hr-app/dashboard.html" class="group bg-white rounded-2xl border border-zinc-200 p-8 hover:border-indigo-600 hover:shadow-lg transition-all">
                <div class="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                    <i data-lucide="building-2" class="w-6 h-6 text-white"></i>
                </div>
                <h2 class="text-xl font-semibold text-zinc-900 mb-2">HR Application</h2>
                <p class="text-zinc-500 text-sm mb-4">For HR Admins to create and manage orders</p>
                <div class="flex items-center text-sm font-medium text-indigo-600">
                    Enter Application
                    <i data-lucide="arrow-right" class="w-4 h-4 ml-2"></i>
                </div>
            </a>
        </div>

        <p class="text-center text-sm text-zinc-400 mt-12">
            &copy; 2024 TalentOps. All rights reserved.
        </p>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>
