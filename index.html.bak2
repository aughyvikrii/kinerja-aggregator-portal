            </div>

            <!-- STEP 2: Subcategory Selection -->
            <div
                x-show="step === 2"
                class="step-enter min-h-screen pt-24 pb-12 bg-gradient-to-b from-slate-50 to-white"
                x-cloak
            >
                <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="mb-8">
                        <button
                            @click="goBack()"
                            class="group flex items-center gap-2 text-slate-500 hover:text-brand-600 font-medium transition-colors mb-6"
                        >
                            <div
                                class="w-8 h-8 bg-white rounded-full shadow flex items-center justify-center group-hover:bg-brand-50 transition-colors"
                            >
                                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                            </div>
                            <span>Kembali</span>
                        </button>
                        <div class="flex items-center gap-3 mb-2">
                            <div
                                class="w-12 h-12 rounded-xl flex items-center justify-center"
                                :class="getCategoryColor()"
                            >
                                <i
                                    :data-lucide="getCategoryIcon()"
                                    class="w-6 h-6 text-white"
                                ></i>
                            </div>
                            <div>
                                <h2
                                    class="font-display text-2xl sm:text-3xl font-bold text-slate-900"
                                    x-text="getCategoryTitle()"
                                ></h2>
                                <p class="text-slate-500">
                                    Pilih jenis layanan yang sesuai kebutuhan
                                    Anda
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Subcategory Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <template
                            x-for="(sub, index) in getSubcategories()"
                            :key="index"
                        >
                            <button
                                @click="selectSubcategory(sub.id)"
                                class="group relative bg-white rounded-2xl border-2 p-6 text-left transition-all duration-300 overflow-hidden"
                                :class="subcategory === sub.id ? 'border-brand-500 shadow-xl shadow-brand-500/10' : 'border-slate-200 hover:border-brand-300 hover:shadow-lg'"
                                :style="`animation-delay: ${index * 0.1}s`"
                                x-transition:enter="transition ease-out duration-300"
                                x-transition:enter-start="opacity-0 translate-y-4"
                                x-transition:enter-end="opacity-100 translate-y-0"
                            >
                                <div
                                    class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br opacity-10 rounded-bl-full transition-opacity group-hover:opacity-20"
                                    :class="sub.gradient"
                                ></div>
                                <div class="flex items-start gap-4 relative">
                                    <div
                                        class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0 transition-transform group-hover:scale-110"
                                        :class="sub.iconBg"
                                    >
                                        <i
                                            :data-lucide="sub.icon"
                                            class="w-7 h-7"
                                            :class="sub.iconColor"
                                        ></i>
                                    </div>
                                    <div class="flex-1">
                                        <h3
                                            class="font-display font-bold text-lg text-slate-900 mb-1"
                                            x-text="sub.name"
                                        ></h3>
                                        <p
                                            class="text-sm text-slate-500 mb-4"
                                            x-text="sub.description"
                                        ></p>
                                        <div class="flex flex-wrap gap-2">
                                            <template x-for="tag in sub.tags">
                                                <span
                                                    class="px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-lg"
                                                    x-text="tag"
                                                ></span>
                                            </template>
                                        </div>
                                    </div>
                                    <div
                                        class="w-8 h-8 rounded-full flex items-center justify-center transition-all"
                                        :class="subcategory === sub.id ? 'bg-brand-500 text-white' : 'bg-slate-100 text-slate-400 group-hover:bg-brand-100 group-hover:text-brand-600'"
                                    >
                                        <i
                                            data-lucide="check"
                                            class="w-4 h-4"
                                            x-show="subcategory === sub.id"
                                        ></i>
                                        <i
                                            data-lucide="chevron-right"
                                            class="w-4 h-4"
                                            x-show="subcategory !== sub.id"
                                        ></i>
                                    </div>
                                </div>
                            </button>
                        </template>
                    </div>
                </div>
            </div>

            <!-- STEP 3: Partner Packages -->
            <div
                x-show="step === 3"
                class="step-enter min-h-screen pt-24 pb-12 bg-gradient-to-b from-slate-50 to-white"
                x-cloak
            >
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="mb-8">
                        <button
                            @click="goBack()"
                            class="group flex items-center gap-2 text-slate-500 hover:text-brand-600 font-medium transition-colors mb-6"
                        >
                            <div
                                class="w-8 h-8 bg-white rounded-full shadow flex items-center justify-center group-hover:bg-brand-50 transition-colors"
                            >
                                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                            </div>
                            <span>Kembali</span>
                        </button>
                        <h2
                            class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mb-2"
                        >
                            Pilih Paket & Partner
                        </h2>
                        <p class="text-slate-500">
                            Bandingkan paket terbaik dari partner terverifikasi
                            kami
                        </p>
                    </div>

                    <!-- Filter Pills -->
                    <div class="flex flex-wrap gap-3 mb-8">
                        <button
                            class="px-5 py-2.5 bg-brand-500 text-white rounded-full text-sm font-semibold shadow-lg shadow-brand-500/25 transition-all hover:scale-105"
                        >
                            Semua
                        </button>
                        <button
                            class="px-5 py-2.5 bg-white text-slate-600 rounded-full text-sm font-medium border border-slate-200 hover:border-brand-300 hover:text-brand-600 transition-all hover:scale-105"
                        >
                            Harga Terendah
                        </button>
                        <button
                            class="px-5 py-2.5 bg-white text-slate-600 rounded-full text-sm font-medium border border-slate-200 hover:border-brand-300 hover:text-brand-600 transition-all hover:scale-105"
                        >
                            Rating Tertinggi
                        </button>
                        <button
                            class="px-5 py-2.5 bg-white text-slate-600 rounded-full text-sm font-medium border border-slate-200 hover:border-brand-300 hover:text-brand-600 transition-all hover:scale-105"
                        >
                            Terdekat
                        </button>
                    </div>

                    <!-- Package Cards -->
                    <div class="space-y-6">
                        <template
                            x-for="(pkg, index) in getPackages()"
                            :key="index"
                        >
                            <div
                                @click="selectPackage(pkg)"
                                class="group bg-white rounded-3xl border-2 p-6 sm:p-8 cursor-pointer transition-all duration-300 relative overflow-hidden"
                                :class="selectedPackage === pkg ? 'border-brand-500 shadow-2xl shadow-brand-500/20' : 'border-slate-200 hover:border-brand-300 hover:shadow-xl'"
                            >
                                <!-- Recommended Badge -->
                                <div
                                    x-show="index === 1"
                                    class="absolute -right-12 top-6 bg-gradient-to-r from-brand-500 to-ocean-500 text-white text-xs font-bold px-12 py-1 rotate-45 shadow-lg"
                                >
                                    RECOMMENDED
                                </div>

                                <div
                                    class="flex flex-col lg:flex-row lg:items-center gap-6"
                                >
                                    <!-- Partner Info -->
                                    <div
                                        class="flex items-center gap-4 lg:w-1/4"
                                    >
                                        <div
                                            class="w-16 h-16 bg-gradient-to-br from-slate-100 to-slate-200 rounded-2xl flex items-center justify-center flex-shrink-0"
                                        >
                                            <i
                                                data-lucide="building-2"
                                                class="w-8 h-8 text-slate-400"
                                            ></i>
                                        </div>
                                        <div>
                                            <div
                                                class="font-display font-bold text-slate-900"
                                                x-text="pkg.partner"
                                            ></div>
                                            <div
                                                class="flex items-center gap-1 text-sm"
                                            >
                                                <i
                                                    data-lucide="star"
                                                    class="w-4 h-4 text-amber-400 fill-amber-400"
                                                ></i>
                                                <span
                                                    class="font-semibold text-slate-700"
                                                    x-text="pkg.rating"
                                                ></span>
                                                <span
                                                    class="text-slate-400"
                                                    x-text="`(${pkg.reviews} reviews)`"
                                                ></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Package Details -->
                                    <div class="lg:w-2/4">
                                        <h3
                                            class="font-display font-bold text-xl text-slate-900 mb-2"
                                            x-text="pkg.name"
                                        ></h3>
                                        <p
                                            class="text-slate-500 mb-4"
                                            x-text="pkg.description"
                                        ></p>
                                        <div class="flex flex-wrap gap-2">
                                            <template
                                                x-for="feature in pkg.features"
                                            >
                                                <span
                                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-50 text-slate-600 text-sm rounded-lg"
                                                >
                                                    <i
                                                        data-lucide="check"
                                                        class="w-4 h-4 text-emerald-500"
                                                    ></i>
                                                    <span
                                                        x-text="feature"
                                                    ></span>
                                                </span>
                                            </template>
                                        </div>
                                    </div>

                                    <!-- Price & CTA -->
                                    <div class="lg:w-1/4 lg:text-right">
                                        <div
                                            class="text-sm text-slate-400 mb-1"
                                        >
                                            Mulai dari
                                        </div>
                                        <div
                                            class="text-3xl font-display font-bold text-slate-900 mb-1"
                                            x-text="formatPrice(pkg.price)"
                                        ></div>
                                        <div
                                            class="text-sm text-slate-500 mb-4"
                                        >
                                            per karyawan
                                        </div>
                                        <button
                                            class="w-full lg:w-auto px-8 py-3 bg-gradient-to-r from-brand-500 to-brand-600 text-white font-semibold rounded-xl hover:from-brand-600 hover:to-brand-700 transition-all hover:scale-105 shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2"
                                        >
                                            <span>Pilih Paket</span>
                                            <i
                                                data-lucide="arrow-right"
                                                class="w-4 h-4"
                                            ></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- STEP 4: Order Details -->
            <div
                x-show="step === 4"
                class="step-enter min-h-screen pt-24 pb-12 bg-gradient-to-b from-slate-50 to-white"
                x-cloak
            >
                <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="mb-8">
                        <button
                            @click="goBack()"
                            class="group flex items-center gap-2 text-slate-500 hover:text-brand-600 font-medium transition-colors mb-6"
                        >
                            <div
                                class="w-8 h-8 bg-white rounded-full shadow flex items-center justify-center group-hover:bg-brand-50 transition-colors"
                            >
                                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                            </div>
                            <span>Kembali</span>
                        </button>
                        <h2
                            class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mb-2"
                        >
                            Detail Pesanan
                        </h2>
                        <p class="text-slate-500">
                            Lengkapi informasi untuk pemesanan Anda
                        </p>
                    </div>

                    <!-- Selected Package Card -->
                    <div
                        class="bg-gradient-to-r from-brand-50 to-ocean-50 border border-brand-100 rounded-2xl p-5 mb-6"
                    >
                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 bg-white rounded-xl flex items-center justify-center shadow-sm"
                            >
                                <i
                                    data-lucide="package"
                                    class="w-6 h-6 text-brand-500"
                                ></i>
                            </div>
                            <div class="flex-1">
                                <div class="text-sm text-slate-500">
                                    Paket Terpilih
                                </div>
                                <div
                                    class="font-semibold text-slate-900"
                                    x-text="selectedPackage?.name"
                                ></div>
                                <div
                                    class="text-sm text-brand-600"
                                    x-text="selectedPackage?.partner"
                                ></div>
                            </div>
                            <div class="text-right">
                                <div
                                    class="text-xl font-bold text-slate-900"
                                    x-text="formatPrice(selectedPackage?.price)"
                                ></div>
                                <div class="text-xs text-slate-500">
                                    per karyawan
                                </div>
                            </div>
                        </div>
                    </div>

                    <form @submit.prevent="goToCompanyInfo()" class="space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Jumlah Karyawan
                                    <span class="text-red-500">*</span></label
                                >
                                <div class="relative">
                                    <input
                                        type="number"
                                        x-model="orderDetails.employeeCount"
                                        required
                                        min="1"
                                        placeholder="Contoh: 50"
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all pl-12"
                                    />
                                    <i
                                        data-lucide="users"
                                        class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                    ></i>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Departemen</label
                                >
                                <select
                                    x-model="orderDetails.department"
                                    class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 bg-white"
                                >
                                    <option value="">Pilih Departemen</option>
                                    <option>Operasional</option>
                                    <option>IT & Teknologi</option>
                                    <option>Sales & Marketing</option>
                                    <option>HR & GA</option>
                                    <option>Finance & Accounting</option>
                                    <option>Produksi</option>
                                    <option>Lainnya</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Tanggal Pelaksanaan
                                    <span class="text-red-500">*</span></label
                                >
                                <div class="relative">
                                    <input
                                        type="date"
                                        x-model="orderDetails.date"
                                        required
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500"
                                    />
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Lokasi</label
                                >
                                <select
                                    x-model="orderDetails.location"
                                    class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 bg-white"
                                >
                                    <option value="">Pilih Lokasi</option>
                                    <option>Jakarta</option>
                                    <option>Surabaya</option>
                                    <option>Bandung</option>
                                    <option>Medan</option>
                                    <option>Yogyakarta</option>
                                    <option>On-site Perusahaan</option>
                                </select>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-700"
                                >Catatan Tambahan</label
                            >
                            <textarea
                                x-model="orderDetails.notes"
                                rows="3"
                                placeholder="Informasi penting lainnya..."
                                class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 resize-none"
                            ></textarea>
                        </div>

                        <!-- Cost Calculator -->
                        <div class="bg-slate-900 text-white rounded-2xl p-6">
                            <div class="flex items-center justify-between">
                                <div>
                                    <div class="text-slate-400 text-sm mb-1">
                                        Estimasi Total Biaya
                                    </div>
                                    <div
                                        class="text-3xl font-display font-bold"
                                        x-text="calculateTotal()"
                                    ></div>
                                </div>
                                <div
                                    class="w-14 h-14 bg-white/10 rounded-xl flex items-center justify-center"
                                >
                                    <i
                                        data-lucide="calculator"
                                        class="w-7 h-7 text-brand-400"
                                    ></i>
                                </div>
                            </div>
                            <p class="text-xs text-slate-400 mt-3">
                                *Harga dapat berubah sesuai detail kebutuhan
                                akhir
                            </p>
                        </div>

                        <button
                            type="submit"
                            class="w-full py-4 bg-gradient-to-r from-brand-500 to-brand-600 text-white font-semibold rounded-xl hover:from-brand-600 hover:to-brand-700 transition-all hover:scale-[1.02] shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2"
                        >
                            <span>Lanjutkan ke Data Perusahaan</span>
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- STEP 5: Company Information -->
            <div
                x-show="step === 5"
                class="step-enter min-h-screen pt-24 pb-12 bg-gradient-to-b from-slate-50 to-white"
                x-cloak
            >
                <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="mb-8">
                        <button
                            @click="goBack()"
                            class="group flex items-center gap-2 text-slate-500 hover:text-brand-600 font-medium transition-colors mb-6"
                        >
                            <div
                                class="w-8 h-8 bg-white rounded-full shadow flex items-center justify-center group-hover:bg-brand-50 transition-colors"
                            >
                                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                            </div>
                            <span>Kembali</span>
                        </button>
                        <h2
                            class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mb-2"
                        >
                            Data Perusahaan
                        </h2>
                        <p class="text-slate-500">
                            Informasi kontak untuk follow-up pesanan
                        </p>
                    </div>

                    <!-- Order Summary -->
                    <div
                        class="bg-gradient-to-r from-slate-50 to-slate-100 rounded-2xl p-5 mb-6 space-y-3"
                    >
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500">Paket</span>
                            <span
                                class="font-semibold text-slate-900"
                                x-text="selectedPackage?.name"
                            ></span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500">Partner</span>
                            <span
                                class="font-semibold text-slate-900"
                                x-text="selectedPackage?.partner"
                            ></span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-slate-500">Jumlah Karyawan</span>
                            <span
                                class="font-semibold text-slate-900"
                                x-text="orderDetails.employeeCount + ' orang'"
                            ></span>
                        </div>
                        <div class="border-t border-slate-200 pt-3">
                            <div class="flex justify-between items-center">
                                <span class="text-slate-900 font-semibold"
                                    >Total Estimasi</span
                                >
                                <span
                                    class="text-2xl font-display font-bold text-brand-600"
                                    x-text="calculateTotal()"
                                ></span>
                            </div>
                        </div>
                    </div>

                    <form @submit.prevent="submitOrder()" class="space-y-5">
                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-700"
                                >Nama Perusahaan
                                <span class="text-red-500">*</span></label
                            >
                            <div class="relative">
                                <input
                                    type="text"
                                    x-model="companyInfo.name"
                                    required
                                    placeholder="PT. Nama Perusahaan"
                                    class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 transition-all pl-12"
                                />
                                <i
                                    data-lucide="building-2"
                                    class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                ></i>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Industri
                                    <span class="text-red-500">*</span></label
                                >
                                <select
                                    x-model="companyInfo.industry"
                                    required
                                    class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 bg-white"
                                >
                                    <option value="">Pilih Industri</option>
                                    <option>Teknologi</option>
                                    <option>Manufaktur</option>
                                    <option>Keuangan / Banking</option>
                                    <option>Retail / E-commerce</option>
                                    <option>Logistik</option>
                                    <option>Konstruksi</option>
                                    <option>Energi / Mining</option>
                                    <option>Healthcare</option>
                                    <option>Lainnya</option>
                                </select>
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Jumlah Karyawan</label
                                >
                                <select
                                    x-model="companyInfo.size"
                                    class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 bg-white"
                                >
                                    <option value="">Pilih Rentang</option>
                                    <option>1-50</option>
                                    <option>51-200</option>
                                    <option>201-500</option>
                                    <option>501-1000</option>
                                    <option>1000+</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Nama PIC
                                    <span class="text-red-500">*</span></label
                                >
                                <div class="relative">
                                    <input
                                        type="text"
                                        x-model="companyInfo.picName"
                                        required
                                        placeholder="Nama lengkap"
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 pl-12"
                                    />
                                    <i
                                        data-lucide="user"
                                        class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                    ></i>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Jabatan</label
                                >
                                <div class="relative">
                                    <input
                                        type="text"
                                        x-model="companyInfo.picPosition"
                                        placeholder="Contoh: HR Manager"
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 pl-12"
                                    />
                                    <i
                                        data-lucide="briefcase"
                                        class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                    ></i>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >Email
                                    <span class="text-red-500">*</span></label
                                >
                                <div class="relative">
                                    <input
                                        type="email"
                                        x-model="companyInfo.email"
                                        required
                                        placeholder="email@perusahaan.com"
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 pl-12"
                                    />
                                    <i
                                        data-lucide="mail"
                                        class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                    ></i>
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label
                                    class="text-sm font-semibold text-slate-700"
                                    >No. WhatsApp
                                    <span class="text-red-500">*</span></label
                                >
                                <div class="relative">
                                    <input
                                        type="tel"
                                        x-model="companyInfo.phone"
                                        required
                                        placeholder="0812-3456-7890"
                                        class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 pl-12"
                                    />
                                    <i
                                        data-lucide="phone"
                                        class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2"
                                    ></i>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-semibold text-slate-700"
                                >Alamat Lengkap</label
                            >
                            <textarea
                                x-model="companyInfo.address"
                                rows="2"
                                placeholder="Alamat kantor..."
                                class="w-full px-4 py-3.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 resize-none"
                            ></textarea>
                        </div>

                        <div class="flex items-start gap-3 pt-2">
                            <input
                                type="checkbox"
                                required
                                id="terms"
                                class="mt-1 w-5 h-5 rounded-lg border-slate-300 text-brand-600 focus:ring-brand-500"
                            />
                            <label for="terms" class="text-sm text-slate-600">
                                Saya menyetujui
                                <a
                                    href="#"
                                    class="text-brand-600 hover:underline font-medium"
                                    >Syarat dan Ketentuan</a
                                >
                                serta
                                <a
                                    href="#"
                                    class="text-brand-600 hover:underline font-medium"
                                    >Kebijakan Privasi</a
                                >
                                SolusiSDM
                            </label>
                        </div>

                        <button
                            type="submit"
                            :disabled="submitting"
                            class="w-full py-4 bg-gradient-to-r from-brand-500 to-brand-600 text-white font-semibold rounded-xl hover:from-brand-600 hover:to-brand-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all hover:scale-[1.02] shadow-lg shadow-brand-500/25 flex items-center justify-center gap-2"
                        >
                            <i
                                x-show="submitting"
                                data-lucide="loader-2"
                                class="w-5 h-5 animate-spin"
                            ></i>
                            <span
                                x-text="submitting ? 'Mengirim...' : 'Kirim Pesanan'"
                            ></span>
                        </button>

                        <p class="text-center text-sm text-slate-500">
                            Tim kami akan menghubungi Anda dalam
                            <span class="font-semibold text-brand-600"
                                >1x24 jam</span
                            >
                        </p>
                    </form>
                </div>
            </div>

            <!-- STEP 6: Success State -->
            <div
                x-show="step === 6"
                class="step-enter min-h-screen flex items-center justify-center bg-gradient-to-b from-slate-50 to-white py-12"
                x-cloak
            >
                <div class="max-w-lg mx-auto px-4 text-center">
                    <!-- Success Animation -->
                    <div class="relative mb-8">
                        <div
                            class="absolute inset-0 bg-emerald-100 rounded-full animate-ping opacity-25"
                        ></div>
                        <div
                            class="w-24 h-24 mx-auto bg-gradient-to-br from-emerald-400 to-emerald-500 rounded-full flex items-center justify-center shadow-xl shadow-emerald-500/30"
                        >
                            <i
                                data-lucide="check"
                                class="w-12 h-12 text-white"
                            ></i>
                        </div>
                    </div>

                    <h2
                        class="font-display text-3xl font-bold text-slate-900 mb-3"
                    >
                        Pesanan Berhasil!
                    </h2>
                    <p class="text-slate-600 mb-8">
                        Terima kasih telah memilih SolusiSDM. Tim kami akan
                        segera menghubungi Anda untuk konfirmasi.
                    </p>

                    <!-- Reference Card -->
                    <div
                        class="bg-white rounded-2xl shadow-xl p-8 mb-8 border border-slate-100"
                    >
                        <div class="text-sm text-slate-500 mb-2">
                            Nomor Referensi Anda
                        </div>
                        <div
                            class="text-3xl font-display font-bold text-slate-900 tracking-wider mb-2"
                            x-text="referenceId"
                        ></div>
                        <p class="text-xs text-slate-400">
                            Simpan nomor ini untuk melacak pesanan
                        </p>
                        <button
                            @click="copyReference()"
                            class="mt-4 text-brand-600 font-medium text-sm flex items-center justify-center gap-2 mx-auto hover:underline"
                        >
                            <i data-lucide="copy" class="w-4 h-4"></i>
                            <span>Salin Nomor</span>
                        </button>
                    </div>

                    <div class="flex flex-col sm:flex-row gap-4">
                        <button
                            @click="resetForm()"
                            class="flex-1 py-3.5 border-2 border-slate-200 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 transition-all"
                        >
                            Pesan Lagi
                        </button>
                        <a
                            href="track-order.html"
                            class="flex-1 py-3.5 bg-gradient-to-r from-brand-500 to-brand-600 text-white font-semibold rounded-xl hover:from-brand-600 hover:to-brand-700 transition-all flex items-center justify-center gap-2"
                        >
                            <i data-lucide="search" class="w-4 h-4"></i>
                            Lacak Pesanan
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <script>
            function publicPortal() {
                return {
                    step: 1,
                    category: "",
                    subcategory: "",
                    selectedPackage: null,
                    submitting: false,
                    referenceId: "",
                    scrolled: false,
                    orderDetails: {
                        employeeCount: "",
                        department: "",
                        date: "",
                        location: "",
                        notes: "",
                    },
                    companyInfo: {
                        name: "",
                        industry: "",
                        size: "",
                        picName: "",
                        picPosition: "",
                        email: "",
                        phone: "",
                        address: "",
                    },

                    init() {
                        window.addEventListener("scroll", () => {
                            this.scrolled = window.scrollY > 50;
                        });
                        this.$nextTick(() => lucide.createIcons());
                    },

                    selectCategory(cat) {
                        this.category = cat;
                        setTimeout(() => {
                            this.step = 2;
                            this.$nextTick(() => lucide.createIcons());
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        }, 300);
                    },

                    selectSubcategory(sub) {
                        this.subcategory = sub;
                        setTimeout(() => {
                            this.step = 3;
                            this.$nextTick(() => lucide.createIcons());
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        }, 300);
                    },

                    selectPackage(pkg) {
                        this.selectedPackage = pkg;
                        setTimeout(() => {
                            this.step = 4;
                            this.$nextTick(() => lucide.createIcons());
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        }, 300);
                    },

                    goBack() {
                        if (this.step === 2) {
                            this.step = 1;
                            this.category = "";
                        } else if (this.step === 3) {
                            this.step = 2;
                            this.subcategory = "";
                        } else if (this.step === 4) {
                            this.step = 3;
                            this.selectedPackage = null;
                        } else if (this.step === 5) {
                            this.step = 4;
                        }
                        this.$nextTick(() => lucide.createIcons());
                    },

                    goToCompanyInfo() {
                        this.step = 5;
                        this.$nextTick(() => lucide.createIcons());
                        window.scrollTo({ top: 0, behavior: "smooth" });
                    },

                    submitOrder() {
                        this.submitting = true;
                        setTimeout(() => {
                            this.submitting = false;
                            this.referenceId =
                                "TRX-" +
                                Math.random()
                                    .toString(36)
                                    .substr(2, 9)
                                    .toUpperCase();
                            this.step = 6;
                            this.$nextTick(() => lucide.createIcons());
                            window.scrollTo({ top: 0, behavior: "smooth" });
                        }, 1500);
                    },

                    copyReference() {
                        navigator.clipboard.writeText(this.referenceId);
                    },

                    resetForm() {
                        this.step = 1;
                        this.category = "";
                        this.subcategory = "";
                        this.selectedPackage = null;
                        this.orderDetails = {
                            employeeCount: "",
                            department: "",
                            date: "",
                            location: "",
                            notes: "",
                        };
                        this.companyInfo = {
                            name: "",
                            industry: "",
                            size: "",
                            picName: "",
                            picPosition: "",
                            email: "",
                            phone: "",
                            address: "",
                        };
                        this.$nextTick(() => lucide.createIcons());
                    },

                    getCategoryTitle() {
                        const titles = {
                            mcu: "Pilih Jenis Medical Check Up",
                            training: "Pilih Program Training",
                            psychological: "Pilih Jenis Psychological Test",
                            manpower: "Pilih Jenis Man Power Supply",
                        };
                        return titles[this.category] || "Pilih Layanan";
                    },

                    getCategoryIcon() {
                        const icons = {
                            mcu: "heart-pulse",
                            training: "graduation-cap",
                            psychological: "brain",
                            manpower: "users",
                        };
                        return icons[this.category] || "box";
                    },

                    getCategoryColor() {
                        const colors = {
                            mcu: "bg-gradient-to-br from-red-400 to-red-500",
                            training:
                                "bg-gradient-to-br from-ocean-400 to-ocean-500",
                            psychological:
                                "bg-gradient-to-br from-violet-400 to-violet-500",
                            manpower:
                                "bg-gradient-to-br from-emerald-400 to-emerald-500",
                        };
                        return (
                            colors[this.category] ||
                            "bg-gradient-to-br from-slate-400 to-slate-500"
                        );
                    },

                    getStepTitle() {
                        const titles = {
                            2: "Pilih Jenis Layanan",
                            3: "Pilih Paket & Partner",
                            4: "Detail Pesanan",
                            5: "Data Perusahaan",
                        };
                        return titles[this.step] || "";
                    },

                    formatPrice(price) {
                        if (!price) return "Rp 0";
                        return "Rp " + price.toLocaleString("id-ID");
                    },

                    calculateTotal() {
                        if (
                            !this.selectedPackage ||
                            !this.orderDetails.employeeCount
                        )
                            return "Rp 0";
                        const total =
                            this.selectedPackage.price *
                            parseInt(this.orderDetails.employeeCount || 0);
                        return this.formatPrice(total);
                    },

                    getSubcategories() {
                        const subcategories = {
                            mcu: [
                                {
                                    id: "mcu-new",
                                    name: "MCU Karyawan Baru",
                                    description:
                                        "Pemeriksaan kesehatan untuk karyawan baru sebelum bergabung dengan perusahaan",
                                    icon: "user-plus",
                                    iconBg: "bg-red-100",
                                    iconColor: "text-red-600",
                                    gradient: "from-red-400 to-red-500",
                                    tags: ["Tes Darah", "X-Ray", "ECG"],
                                },
                                {
                                    id: "mcu-routine",
                                    name: "MCU Rutin Tahunan",
                                    description:
                                        "Pemeriksaan kesehatan berkala untuk seluruh karyawan perusahaan",
                                    icon: "calendar-check",
                                    iconBg: "bg-orange-100",
                                    iconColor: "text-orange-600",
                                    gradient: "from-orange-400 to-orange-500",
                                    tags: [
                                        "Basic Panel",
                                        "Fisik",
                                        "Konsultasi",
                                    ],
                                },
                                {
                                    id: "mcu-executive",
                                    name: "MCU Executive",
                                    description:
                                        "Pemeriksaan komprehensif untuk level manajerial dan direksi",
                                    icon: "crown",
                                    iconBg: "bg-purple-100",
                                    iconColor: "text-purple-600",
                                    gradient: "from-purple-400 to-purple-500",
                                    tags: [
                                        "Full Panel",
                                        "Heart Check",
                                        "Premium",
                                    ],
                                },
                                {
                                    id: "mcu-custom",
                                    name: "MCU Custom",
                                    description:
                                        "Paket pemeriksaan yang dapat disesuaikan dengan kebutuhan spesifik",
                                    icon: "settings",
                                    iconBg: "bg-blue-100",
                                    iconColor: "text-blue-600",
                                    gradient: "from-blue-400 to-blue-500",
                                    tags: ["Flexible", "Custom Panel"],
                                },
                            ],
                            training: [
                                {
                                    id: "training-leadership",
                                    name: "Leadership Development",
                                    description:
                                        "Program pengembangan kepemimpinan untuk manager dan supervisor",
                                    icon: "crown",
                                    iconBg: "bg-amber-100",
                                    iconColor: "text-amber-600",
                                    gradient: "from-amber-400 to-amber-500",
                                    tags: ["3-5 Hari", "Sertifikat"],
                                },
                                {
                                    id: "training-technical",
                                    name: "Technical Skills",
                                    description:
                                        "Pelatihan skill teknis sesuai bidang pekerjaan",
                                    icon: "code",
                                    iconBg: "bg-blue-100",
                                    iconColor: "text-blue-600",
                                    gradient: "from-blue-400 to-blue-500",
                                    tags: ["2-10 Hari", "Hands-on"],
                                },
                                {
                                    id: "training-soft",
                                    name: "Soft Skills",
                                    description:
                                        "Komunikasi, teamwork, problem solving, dan time management",
                                    icon: "heart-handshake",
                                    iconBg: "bg-pink-100",
                                    iconColor: "text-pink-600",
                                    gradient: "from-pink-400 to-pink-500",
                                    tags: ["1-3 Hari", "Workshop"],
                                },
                                {
                                    id: "training-compliance",
                                    name: "Safety & Compliance",
                                    description:
                                        "K3, compliance training, dan sertifikasi wajib",
                                    icon: "shield-check",
                                    iconBg: "bg-emerald-100",
                                    iconColor: "text-emerald-600",
                                    gradient: "from-emerald-400 to-emerald-500",
                                    tags: ["Sertifikasi", "K3"],
                                },
                            ],
                            psychological: [
                                {
                                    id: "psych-recruitment",
                                    name: "Pre-Employment Screening",
                                    description:
                                        "Tes psikologi untuk seleksi karyawan baru",
                                    icon: "user-search",
                                    iconBg: "bg-violet-100",
                                    iconColor: "text-violet-600",
                                    gradient: "from-violet-400 to-violet-500",
                                    tags: ["Kepribadian", "Aptitude"],
                                },
                                {
                                    id: "psych-leadership",
                                    name: "Leadership Assessment",
                                    description:
                                        "Penilaian potensi kepemimpinan dan manajerial",
                                    icon: "trending-up",
                                    iconBg: "bg-indigo-100",
                                    iconColor: "text-indigo-600",
                                    gradient: "from-indigo-400 to-indigo-500",
                                    tags: ["Assessment Center", "360 Review"],
                                },
                                {
                                    id: "psych-team",
                                    name: "Team Compatibility",
                                    description:
                                        "Analisis kompatibilitas tim dan work style",
                                    icon: "users",
                                    iconBg: "bg-cyan-100",
                                    iconColor: "text-cyan-600",
                                    gradient: "from-cyan-400 to-cyan-500",
                                    tags: ["Team Building", "Compatibility"],
                                },
                                {
                                    id: "psych-wellness",
                                    name: "Wellness & Stress Check",
                                    description:
                                        "Penilaian kesehatan mental dan tingkat stress",
                                    icon: "heart",
