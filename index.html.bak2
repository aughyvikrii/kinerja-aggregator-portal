                            </div>
                            <div>
                                <h4 class="text-white font-semibold mb-4">
                                    Perusahaan
                                </h4>
                                <ul class="space-y-2 text-sm">
                                    <li>
                                        <a
                                            href="#"
                                            class="hover:text-brand-400 transition-colors"
                                            >Tentang Kami</a
                                        >
                                    </li>
                                    <li>
                                        <a
                                            href="#"
                                            class="hover:text-brand-400 transition-colors"
                                            >Partner</a
                                        >
                                    </li>
                                    <li>
                                        <a
                                            href="#"
                                            class="hover:text-brand-400 transition-colors"
                                            >Karir</a
