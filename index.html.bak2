<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>SolusiSDM - Solusi Workforce Terbaik untuk Tim Anda</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script
            defer
            src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
        ></script>
        <script src="https://unpkg.com/lucide@latest"></script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
            rel="stylesheet"
        />
        <script>
            tailwind.config = {
                theme: {
                    extend: {
                        fontFamily: {
                            sans: ["Inter", "sans-serif"],
                            display: ["Plus Jakarta Sans", "sans-serif"],
                        },
                        colors: {
                            brand: {
                                50: "#fff7ed",
                                100: "#ffedd5",
                                200: "#fed7aa",
                                300: "#fdba74",
                                400: "#fb923c",
                                500: "#f97316",
                                600: "#ea580c",
                                700: "#c2410c",
                            },
                            ocean: {
                                50: "#f0f9ff",
                                100: "#e0f2fe",
                                200: "#bae6fd",
                                300: "#7dd3fc",
                                400: "#38bdf8",
                                500: "#0ea5e9",
                                600: "#0284c7",
                                700: "#0369a1",
                            },
                        },
                        animation: {
                            float: "float 6s ease-in-out infinite",
                            "float-delayed": "float 6s ease-in-out 2s infinite",
                            "float-slow": "float 8s ease-in-out 1s infinite",
                            "pulse-slow":
                                "pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite",
                            "slide-up": "slideUp 0.6s ease-out forwards",
                            "slide-in-right":
                                "slideInRight 0.5s ease-out forwards",
                            "fade-in": "fadeIn 0.5s ease-out forwards",
                            "scale-in": "scaleIn 0.4s ease-out forwards",
                            "bounce-soft": "bounceSoft 2s ease-in-out infinite",
                        },
                        keyframes: {
                            float: {
                                "0%, 100%": {
                                    transform: "translateY(0px) rotate(0deg)",
                                },
                                "50%": {
                                    transform: "translateY(-20px) rotate(5deg)",
                                },
                            },
                            slideUp: {
                                "0%": {
                                    opacity: "0",
                                    transform: "translateY(30px)",
                                },
                                "100%": {
                                    opacity: "1",
                                    transform: "translateY(0)",
                                },
                            },
                            slideInRight: {
                                "0%": {
                                    opacity: "0",
                                    transform: "translateX(30px)",
                                },
                                "100%": {
                                    opacity: "1",
                                    transform: "translateX(0)",
                                },
                            },
                            fadeIn: {
                                "0%": { opacity: "0" },
                                "100%": { opacity: "1" },
                            },
                            scaleIn: {
                                "0%": { opacity: "0", transform: "scale(0.9)" },
                                "100%": { opacity: "1", transform: "scale(1)" },
                            },
                            bounceSoft: {
                                "0%, 100%": { transform: "translateY(0)" },
                                "50%": { transform: "translateY(-10px)" },
                            },
                        },
                    },
                },
            };
        </script>
        <style>
            .glass {
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.3);
            }
            .glass-dark {
                background: rgba(15, 23, 42, 0.8);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
            .gradient-hero {
                background: linear-gradient(
                    135deg,
                    #fff7ed 0%,
                    #ffedd5 25%,
                    #fed7aa 50%,
                    #bae6fd 75%,
                    #e0f2fe 100%
                );
            }
            .gradient-text {
                background: linear-gradient(
                    135deg,
                    #ea580c 0%,
                    #f97316 50%,
                    #0ea5e9 100%
                );
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }
            .card-hover {
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .card-hover:hover {
                transform: translateY(-8px) scale(1.02);
                box-shadow: 0 25px 50px -12px rgba(249, 115, 22, 0.25);
            }
            .blob {
                position: absolute;
                filter: blur(60px);
                opacity: 0.6;
                animation: blob 8s infinite;
            }
            @keyframes blob {
                0%,
                100% {
                    transform: translate(0, 0) scale(1);
                }
                33% {
                    transform: translate(30px, -50px) scale(1.1);
                }
                66% {
                    transform: translate(-20px, 20px) scale(0.9);
                }
            }
            .step-enter {
                animation: slideUp 0.5s ease-out forwards;
            }
            .step-exit {
                animation: fadeOut 0.3s ease-in forwards;
            }
            @keyframes fadeOut {
                to {
                    opacity: 0;
                    transform: translateX(-20px);
                }
            }
            .shine {
                position: relative;
                overflow: hidden;
            }
            .shine::after {
                content: "";
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: linear-gradient(
                    to right,
                    rgba(255, 255, 255, 0) 0%,
                    rgba(255, 255, 255, 0.3) 50%,
                    rgba(255, 255, 255, 0) 100%
                );
                transform: rotate(30deg);
                animation: shine 3s infinite;
            }
            @keyframes shine {
                0% {
                    transform: translateX(-100%) rotate(30deg);
                }
                100% {
                    transform: translateX(100%) rotate(30deg);
                }
            }
            .progress-bar {
                background: linear-gradient(90deg, #f97316 0%, #0ea5e9 100%);
            }
            .floating-card {
                animation: floatCard 5s ease-in-out infinite;
            }
            @keyframes floatCard {
                0%,
                100% {
                    transform: translateY(0) rotate(-2deg);
                }
                50% {
                    transform: translateY(-15px) rotate(2deg);
                }
            }
            [x-cloak] {
                display: none !important;
            }
        </style>
    </head>
    <body class="font-sans antialiased" x-data="publicPortal()" x-init="init()">
        <!-- Navigation -->
        <header
            class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
            :class="scrolled ? 'glass shadow-lg' : 'bg-transparent'"
        >
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center justify-between h-20">
                    <a href="index.html" class="flex items-center gap-3 group">
                        <div
                            class="w-10 h-10 bg-gradient-to-br from-brand-500 to-ocean-500 rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                        >
                            <i
                                data-lucide="hexagon"
                                class="w-5 h-5 text-white"
                            ></i>
                        </div>
                        <span
                            class="font-display font-bold text-2xl text-slate-800"
                            >Talent<span class="gradient-text">Ops</span></span
                        >
                    </a>
                    <nav class="hidden md:flex items-center gap-8">
                        <a
                            href="#layanan"
                            class="text-slate-600 hover:text-brand-600 font-medium transition-colors"
                            >Layanan</a
                        >
                        <a
                            href="#cara-kerja"
                            class="text-slate-600 hover:text-brand-600 font-medium transition-colors"
                            >Cara Kerja</a
                        >
                        <a
                            href="#testimoni"
                            class="text-slate-600 hover:text-brand-600 font-medium transition-colors"
                            >Testimoni</a
                        >
                    </nav>
                    <div class="flex items-center gap-4">
                        <a
                            href="track-order.html"
                            class="hidden sm:flex items-center gap-2 text-slate-600 hover:text-brand-600 font-medium transition-colors"
                        >
                            <i data-lucide="search" class="w-4 h-4"></i>
                            Lacak Pesanan
                        </a>
                        <a
                            href="../aggregator-platform/login.html"
                            class="px-5 py-2.5 bg-slate-900 text-white font-medium rounded-full hover:bg-slate-800 transition-all hover:scale-105 shadow-lg"
                        >
                            Partner Login
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Progress Bar (shown after step 1) -->
        <div
            x-show="step > 1 && step < 6"
            class="fixed top-20 left-0 right-0 glass z-40"
            x-cloak
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="-translate-y-full"
            x-transition:enter-end="translate-y-0"
        >
            <div class="max-w-3xl mx-auto px-4 py-4">
                <div class="flex items-center justify-between mb-3">
                    <span
                        class="text-sm font-semibold text-slate-800"
                        x-text="getStepTitle()"
                    ></span>
                    <span class="text-sm text-slate-500"
                        >Langkah <span x-text="step - 1"></span> dari 4</span
                    >
                </div>
                <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div
                        class="h-full progress-bar rounded-full transition-all duration-500 ease-out"
                        :style="`width: ${((step - 1) / 4) * 100}%`"
                    ></div>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main>
            <!-- STEP 1: Hero + Category Selection -->
            <div x-show="step === 1" x-cloak>
                <!-- Hero Section -->
                <section
                    class="relative min-h-screen gradient-hero pt-32 pb-20 overflow-hidden"
                >
                    <!-- Animated Background Blobs -->
                    <div
                        class="blob bg-brand-300 w-96 h-96 rounded-full top-20 -left-20"
                    ></div>
                    <div
                        class="blob bg-ocean-300 w-80 h-80 rounded-full bottom-20 -right-20"
                        style="animation-delay: 2s"
                    ></div>
                    <div
                        class="blob bg-purple-300 w-64 h-64 rounded-full top-1/2 left-1/3"
                        style="animation-delay: 4s"
                    ></div>

                    <div
                        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
                    >
                        <div class="text-center max-w-4xl mx-auto mb-16">
                            <div
                                class="inline-flex items-center gap-2 px-4 py-2 bg-white/60 backdrop-blur rounded-full text-sm font-medium text-slate-700 mb-6 animate-fade-in shadow-sm"
                            >
                                <span
                                    class="w-2 h-2 bg-brand-500 rounded-full animate-pulse"
                                ></span>
                                Solusi Workforce Terpercaya
                            </div>
                            <h1
                                class="font-display text-4xl sm:text-5xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight animate-slide-up"
                            >
                                Wujudkan Potensi<br />
                                <span class="gradient-text">Tim Terbaik</span>
                                Anda
                            </h1>
                            <p
                                class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 animate-slide-up"
                                style="animation-delay: 0.1s"
                            >
                                Platform lengkap untuk Medical Check Up,
                                Training, Psychological Test, dan Man Power
                                Supply. Partner terpercaya untuk pertumbuhan
                                perusahaan Anda.
                            </p>

                            <!-- Trust Badges -->
                            <div
                                class="flex flex-wrap items-center justify-center gap-6 mb-16 animate-slide-up"
                                style="animation-delay: 0.2s"
                            >
                                <div
                                    class="flex items-center gap-2 px-4 py-2 bg-white/70 backdrop-blur rounded-full shadow-sm"
                                >
                                    <div
                                        class="w-8 h-8 bg-emerald-100 rounded-full flex items-center justify-center"
                                    >
                                        <i
                                            data-lucide="shield-check"
                                            class="w-4 h-4 text-emerald-600"
                                        ></i>
                                    </div>
                                    <span
                                        class="text-sm font-medium text-slate-700"
                                        >Partner Terverifikasi</span
                                    >
                                </div>
                                <div
                                    class="flex items-center gap-2 px-4 py-2 bg-white/70 backdrop-blur rounded-full shadow-sm"
                                >
                                    <div
                                        class="w-8 h-8 bg-brand-100 rounded-full flex items-center justify-center"
                                    >
                                        <i
                                            data-lucide="zap"
                                            class="w-4 h-4 text-brand-600"
                                        ></i>
                                    </div>
                                    <span
                                        class="text-sm font-medium text-slate-700"
                                        >Proses Express</span
                                    >
                                </div>
                                <div
                                    class="flex items-center gap-2 px-4 py-2 bg-white/70 backdrop-blur rounded-full shadow-sm"
                                >
                                    <div
                                        class="w-8 h-8 bg-ocean-100 rounded-full flex items-center justify-center"
                                    >
                                        <i
                                            data-lucide="badge-check"
                                            class="w-4 h-4 text-ocean-600"
                                        ></i>
                                    </div>
                                    <span
                                        class="text-sm font-medium text-slate-700"
                                        >Jaminan Kualitas</span
                                    >
                                </div>
                            </div>
                        </div>

                        <!-- Category Cards Grid -->
                        <div
                            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto"
                        >
                            <!-- MCU -->
                            <button
                                @click="selectCategory('mcu')"
                                class="group relative bg-white rounded-3xl p-6 text-left card-hover shadow-xl border-2 transition-all duration-300"
                                :class="category === 'mcu' ? 'border-brand-500 ring-4 ring-brand-500/20' : 'border-transparent'"
                            >
                                <div
                                    class="absolute -top-4 -right-4 w-16 h-16 bg-gradient-to-br from-red-400 to-red-500 rounded-2xl flex items-center justify-center shadow-lg transform rotate-12 group-hover:rotate-0 group-hover:scale-110 transition-all duration-300"
                                >
                                    <i
                                        data-lucide="heart-pulse"
                                        class="w-8 h-8 text-white"
                                    ></i>
                                </div>
                                <div class="pt-8">
                                    <div
                                        class="inline-flex px-3 py-1 bg-red-50 text-red-600 text-xs font-bold rounded-full mb-3"
                                    >
                                        Kesehatan
                                    </div>
                                    <h3
                                        class="font-display font-bold text-xl text-slate-900 mb-2"
                                    >
                                        Medical Check Up
                                    </h3>
                                    <p class="text-sm text-slate-500 mb-4">
                                        Pemeriksaan kesehatan lengkap untuk
                                        karyawan dengan partner klinik terbaik
                                    </p>
                                    <div
                                        class="flex items-center text-brand-600 font-semibold text-sm group-hover:gap-3 transition-all"
                                    >
                                        <span>Pilih Layanan</span>
                                        <i
                                            data-lucide="arrow-right"
                                            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                                        ></i>
                                    </div>
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-400 to-red-500 rounded-b-3xl transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
                                ></div>
                            </button>

                            <!-- Training -->
                            <button
                                @click="selectCategory('training')"
                                class="group relative bg-white rounded-3xl p-6 text-left card-hover shadow-xl border-2 transition-all duration-300"
                                :class="category === 'training' ? 'border-brand-500 ring-4 ring-brand-500/20' : 'border-transparent'"
                            >
                                <div
                                    class="absolute -top-4 -right-4 w-16 h-16 bg-gradient-to-br from-ocean-400 to-ocean-500 rounded-2xl flex items-center justify-center shadow-lg transform rotate-12 group-hover:rotate-0 group-hover:scale-110 transition-all duration-300"
                                >
                                    <i
                                        data-lucide="graduation-cap"
                                        class="w-8 h-8 text-white"
                                    ></i>
                                </div>
                                <div class="pt-8">
                                    <div
                                        class="inline-flex px-3 py-1 bg-ocean-50 text-ocean-600 text-xs font-bold rounded-full mb-3"
                                    >
                                        Pengembangan
                                    </div>
                                    <h3
                                        class="font-display font-bold text-xl text-slate-900 mb-2"
                                    >
                                        Training
                                    </h3>
                                    <p class="text-sm text-slate-500 mb-4">
                                        Program pengembangan skill dan
                                        kompetensi untuk meningkatkan performa
                                        tim
                                    </p>
                                    <div
                                        class="flex items-center text-brand-600 font-semibold text-sm group-hover:gap-3 transition-all"
                                    >
                                        <span>Pilih Layanan</span>
                                        <i
                                            data-lucide="arrow-right"
                                            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                                        ></i>
                                    </div>
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-ocean-400 to-ocean-500 rounded-b-3xl transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
                                ></div>
                            </button>

                            <!-- Psych Test -->
                            <button
                                @click="selectCategory('psychological')"
                                class="group relative bg-white rounded-3xl p-6 text-left card-hover shadow-xl border-2 transition-all duration-300"
                                :class="category === 'psychological' ? 'border-brand-500 ring-4 ring-brand-500/20' : 'border-transparent'"
                            >
                                <div
                                    class="absolute -top-4 -right-4 w-16 h-16 bg-gradient-to-br from-violet-400 to-violet-500 rounded-2xl flex items-center justify-center shadow-lg transform rotate-12 group-hover:rotate-0 group-hover:scale-110 transition-all duration-300"
                                >
                                    <i
                                        data-lucide="brain"
                                        class="w-8 h-8 text-white"
                                    ></i>
                                </div>
                                <div class="pt-8">
                                    <div
                                        class="inline-flex px-3 py-1 bg-violet-50 text-violet-600 text-xs font-bold rounded-full mb-3"
                                    >
                                        Assessment
                                    </div>
                                    <h3
                                        class="font-display font-bold text-xl text-slate-900 mb-2"
                                    >
                                        Psychological Test
                                    </h3>
                                    <p class="text-sm text-slate-500 mb-4">
                                        Tes psikologi dan penilaian mental untuk
                                        seleksi dan pengembangan karyawan
                                    </p>
                                    <div
                                        class="flex items-center text-brand-600 font-semibold text-sm group-hover:gap-3 transition-all"
                                    >
                                        <span>Pilih Layanan</span>
                                        <i
                                            data-lucide="arrow-right"
                                            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                                        ></i>
                                    </div>
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-violet-400 to-violet-500 rounded-b-3xl transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
                                ></div>
                            </button>

                            <!-- Man Power -->
                            <button
                                @click="selectCategory('manpower')"
                                class="group relative bg-white rounded-3xl p-6 text-left card-hover shadow-xl border-2 transition-all duration-300"
                                :class="category === 'manpower' ? 'border-brand-500 ring-4 ring-brand-500/20' : 'border-transparent'"
                            >
                                <div
                                    class="absolute -top-4 -right-4 w-16 h-16 bg-gradient-to-br from-emerald-400 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg transform rotate-12 group-hover:rotate-0 group-hover:scale-110 transition-all duration-300"
                                >
                                    <i
                                        data-lucide="users"
                                        class="w-8 h-8 text-white"
                                    ></i>
                                </div>
                                <div class="pt-8">
                                    <div
                                        class="inline-flex px-3 py-1 bg-emerald-50 text-emerald-600 text-xs font-bold rounded-full mb-3"
                                    >
                                        Rekrutmen
                                    </div>
                                    <h3
                                        class="font-display font-bold text-xl text-slate-900 mb-2"
                                    >
                                        Man Power Supply
                                    </h3>
                                    <p class="text-sm text-slate-500 mb-4">
                                        Penyediaan tenaga kerja profesional dan
                                        berkualitas untuk kebutuhan bisnis
                                    </p>
                                    <div
                                        class="flex items-center text-brand-600 font-semibold text-sm group-hover:gap-3 transition-all"
                                    >
                                        <span>Pilih Layanan</span>
                                        <i
                                            data-lucide="arrow-right"
                                            class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform"
                                        ></i>
                                    </div>
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-400 to-emerald-500 rounded-b-3xl transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300"
                                ></div>
                            </button>
                        </div>

                        <!-- Stats Section -->
                        <div
                            class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto"
                        >
                            <div class="text-center">
                                <div
                                    class="text-3xl sm:text-4xl font-display font-bold gradient-text mb-1"
                                >
                                    500+
                                </div>
                                <div class="text-sm text-slate-600">
                                    Perusahaan Klien
                                </div>
                            </div>
                            <div class="text-center">
                                <div
                                    class="text-3xl sm:text-4xl font-display font-bold gradient-text mb-1"
                                >
                                    50+
                                </div>
                                <div class="text-sm text-slate-600">
                                    Partner Terverifikasi
                                </div>
                            </div>
                            <div class="text-center">
                                <div
                                    class="text-3xl sm:text-4xl font-display font-bold gradient-text mb-1"
                                >
                                    10K+
                                </div>
                                <div class="text-sm text-slate-600">
                                    Karyawan Terlayani
                                </div>
                            </div>
                            <div class="text-center">
                                <div
                                    class="text-3xl sm:text-4xl font-display font-bold gradient-text mb-1"
                                >
                                    4.9
                                </div>
                                <div class="text-sm text-slate-600">
                                    Rating Kepuasan
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Features Section -->
                <section id="cara-kerja" class="py-24 bg-white">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="text-center max-w-3xl mx-auto mb-16">
                            <span
                                class="inline-flex px-4 py-1.5 bg-brand-50 text-brand-600 text-sm font-bold rounded-full mb-4"
                                >Mudah & Cepat</span
                            >
                            <h2
                                class="font-display text-3xl sm:text-4xl font-bold text-slate-900 mb-4"
                            >
                                Cara Kerja SolusiSDM
                            </h2>
                            <p class="text-lg text-slate-600">
                                Pesan layanan workforce hanya dalam 4 langkah
                                sederhana
                            </p>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                            <div class="relative text-center group">
                                <div
                                    class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-brand-100 to-brand-200 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                                >
                                    <span
                                        class="font-display text-3xl font-bold text-brand-600"
                                        >1</span
                                    >
                                </div>
                                <h3
                                    class="font-display font-bold text-lg text-slate-900 mb-2"
                                >
                                    Pilih Kategori
                                </h3>
                                <p class="text-sm text-slate-500">
                                    Pilih layanan yang sesuai kebutuhan tim Anda
                                </p>
                                <div
                                    class="hidden md:block absolute top-10 left-[60%] w-full h-0.5 bg-gradient-to-r from-brand-200 to-transparent"
                                ></div>
                            </div>

                            <div class="relative text-center group">
                                <div
                                    class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-ocean-100 to-ocean-200 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                                >
                                    <span
                                        class="font-display text-3xl font-bold text-ocean-600"
                                        >2</span
                                    >
                                </div>
                                <h3
                                    class="font-display font-bold text-lg text-slate-900 mb-2"
                                >
                                    Pilih Paket
                                </h3>
                                <p class="text-sm text-slate-500">
                                    Bandingkan dan pilih paket dari partner
                                    terbaik
                                </p>
                                <div
                                    class="hidden md:block absolute top-10 left-[60%] w-full h-0.5 bg-gradient-to-r from-ocean-200 to-transparent"
                                ></div>
                            </div>

                            <div class="relative text-center group">
                                <div
                                    class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-violet-100 to-violet-200 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                                >
                                    <span
                                        class="font-display text-3xl font-bold text-violet-600"
                                        >3</span
                                    >
                                </div>
                                <h3
                                    class="font-display font-bold text-lg text-slate-900 mb-2"
                                >
                                    Isi Detail
                                </h3>
                                <p class="text-sm text-slate-500">
                                    Lengkapi informasi pesanan dengan mudah
                                </p>
                                <div
                                    class="hidden md:block absolute top-10 left-[60%] w-full h-0.5 bg-gradient-to-r from-violet-200 to-transparent"
                                ></div>
                            </div>

                            <div class="text-center group">
                                <div
                                    class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-emerald-100 to-emerald-200 rounded-2xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300"
                                >
                                    <span
                                        class="font-display text-3xl font-bold text-emerald-600"
                                        >4</span
                                    >
                                </div>
                                <h3
                                    class="font-display font-bold text-lg text-slate-900 mb-2"
                                >
                                    Selesai!
                                </h3>
                                <p class="text-sm text-slate-500">
                                    Tim kami akan segera menghubungi Anda
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Footer Preview -->
                <footer class="bg-slate-900 text-slate-400 py-16">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div
                            class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12"
                        >
                            <div>
                                <div class="flex items-center gap-2 mb-4">
                                    <div
                                        class="w-10 h-10 bg-gradient-to-br from-brand-500 to-ocean-500 rounded-xl flex items-center justify-center"
                                    >
                                        <i
                                            data-lucide="hexagon"
                                            class="w-5 h-5 text-white"
                                        ></i>
                                    </div>
                                    <span
                                        class="font-display font-bold text-xl text-white"
                                        >Talent<span class="text-brand-400"
                                            >Ops</span
                                        ></span
                                    >
                                </div>
                                <p class="text-sm">
                                    Solusi workforce terintegrasi untuk
                                    pertumbuhan perusahaan Anda.
                                </p>
